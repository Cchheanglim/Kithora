# Copy to .env (same folder) and fill in. Never commit .env.

# Free key: https://aistudio.google.com/apikey  (free tier: Google may use submitted audio to improve its products)
GEMINI_API_KEY=

# Engine used when a request doesn't name one: gemini-3.5-transcribe | mock-deterministic
KETHRA_DEFAULT_ENGINE=gemini-3.5-transcribe

# Languages hinted to Gemini (comma-separated BCP-47). Leave empty for automatic detection.
GEMINI_LANGUAGE_CODES=km-KH,en-US

# Defaults to a SQLite file in python_backend/. For Postgres: postgresql+psycopg://user:pass@localhost:5432/kethra
# DATABASE_URL=

# Set to true when served over HTTPS so the login cookie is never sent over plain HTTP.
KETHRA_COOKIE_SECURE=false

# Limits (defaults shown)
# KETHRA_MAX_UPLOAD_BYTES=26214400
# KETHRA_RATE_LIMIT_PER_MINUTE=30
# KETHRA_ENGINE_TIMEOUT_SECONDS=30
# KETHRA_MAX_STREAMS_PER_USER=2
# KETHRA_WS_SESSION_TIMEOUT_SECONDS=600
# KETHRA_WS_IDLE_TIMEOUT_SECONDS=60
